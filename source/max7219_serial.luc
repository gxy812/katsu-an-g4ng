module max7219_serial #(
    CHAIN = 1 : CHAIN > 0,
    SPEED = 4 : SPEED >= 0
)
(
    input clk,  // clock
    input rst,  // reset
    input addr_in[8*CHAIN],
    input din[8*CHAIN],
    input start,
    output cs,
    output dout,
    output sck,
    output busy,
    output debug_state[8],
    output debug_counter[8],
    output debug_writer[$clog2(8*CHAIN)*2],
    output debug_data[8],
    output debug_address[8]
) {
    enum States {
        IDLE, PREPARE, TRANSFER_ADDR, TRANSFER_DATA, CHECK_CHAIN, WAIT_LATCH, SET_LATCH
    }
    // full bitwidth for transfers
    const FULL_WIDTH = 8 * CHAIN
    .clk (clk) {
        .rst(rst) { 
            counter slowclock(#SIZE(30));
            dff state[$width(States)](#INIT(States.IDLE));
            dff address_write_pointer[$clog2(FULL_WIDTH)](#INIT(0));
            dff data_write_pointer[$clog2(FULL_WIDTH)](#INIT(1));
            dff data[FULL_WIDTH](#INIT(0));
            dff addr[FULL_WIDTH](#INIT(0));
            dff load_state(#INIT(1)); 
            dff chain[$clog2(CHAIN)](#INIT(1));
        }
        // transition fsm on falling edges so that dout is held during rising edge
        edge_detector slowclock_edge(#RISE(0), #FALL(1), .in(slowclock.value[SPEED]))
    }

    sig slowclock_value;

    always  {
        slowclock_value = slowclock.value[SPEED]; // index 4 is minimum, because 100/2^4 Mhz = 6.125Mhz, set to higher value like 27 to debug
        sck = slowclock_value
        
        busy = state.q != States.IDLE;  // busy when not idle
        dout = 0
        
        debug_state = 8b11111111;
        debug_counter = 0;
        debug_writer = c{address_write_pointer.q, data_write_pointer.q};
        debug_data = data.q;
        debug_address = addr.q;
        
        case (state.q) {
            States.IDLE:
                debug_state = 8b1111; // In IDLE state
                if (start) { // if we should start a new transfer
                    // save our data and address values to memory
                    addr.d = addr_in;
                    data.d = din;
                    
                    // reset the address writer dff
                    address_write_pointer.d = 0;
                    
                    // reset the data writer dff
                    data_write_pointer.d = FULL_WIDTH - 1
                    
                    // reset the chain register
                    chain.d = CHAIN - 1
                    state.d = States.PREPARE
                }
                
            States.PREPARE:
                // guarantee data available before transfer begins
                // also align clock signals
                if (slowclock_edge.out) {
                    // Toggle the load pin (makes the 7219 start listening for data)
                    load_state.d = 0;
                    state.d = States.TRANSFER_ADDR;
                }
                
            States.TRANSFER_ADDR:
                debug_state = 8b11; // in transfer addr state
                dout = addr.q[address_write_pointer.q];
                if (slowclock_edge.out){
                    address_write_pointer.d = address_write_pointer.q + 1; // write the next address bit   
                    if (&address_write_pointer.q[2:0]) {
                        state.d = States.TRANSFER_DATA;
                    }
                }
                
            States.TRANSFER_DATA:
                debug_state = 8b111; // in transfer data state 
                dout = data.q[data_write_pointer.q];
                
                if (slowclock_edge.out){
                    data_write_pointer.d = data_write_pointer.q - 1; // write the next data bit
                    if (~|data_write_pointer.q[2:0]) {
                        state.d = States.CHECK_CHAIN
                    }
                }
                
            States.CHECK_CHAIN:
                // default assumption:
                // we have not finished writing all sets of 16 bits data (address+data) to all matrices/segs in the chain 
                chain.d = chain.q - 1;
                // proceed to the next set
                state.d = States.TRANSFER_ADDR
                if (chain.q == 4){
                    // we have pumped all sets of 16 bits data to the chain, time to latch
                    state.d = States.WAIT_LATCH;
                }
                
            States.WAIT_LATCH:
                // disable clock early to prevent extra bits
                sck = 0
                state.d = States.SET_LATCH;
            
            States.SET_LATCH:
                // latch the data by pulsing the load pin (cs)
                load_state.d = 1
                if (slowclock_edge.out) {
                    state.d = States.IDLE
                }
            
        }
        cs = load_state.q;
    }
}
