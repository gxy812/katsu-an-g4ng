module instruction_rom #(
    WORDS = 16 // total instructions in this ROM
)(
    input addr[$clog2(WORDS)], // this ROM is WORD addressable
    output out[32],
output numinstr[10]
) {
    
    // Driver code, the bottommost instruction is the first instruction
    const INSTRUCTIONS = {
        32h7BE3FFFB, // 0x01C BNE(R3, 0x00C, R31)
        32h08000001, // 0x018 ROLC(R0, 1, R0)
        32h64020000, // 0x014 ST(R0, 0, R2) -- write r0 to [r2] which is the display's address
        32h8043D800, // 0x010 ADD(R3, BP, R2) -- r2 = r3 + bp
        32hC4630004, // 0x00C SUBC(R3, 4, R3) -- r3 -= 4
        32hC07F0080, // 0x008 ADDC(R31, 0x80, R3) -- r3 = 7*4*4 -> 4 full loops
        32hC01F00FF, // 0x004 ADDC(R31, 0x6AE7, R0) -- display value
        32hC37F8000  // 0x000 ADDC(R31, -2^16, BP) --- main
    }
    
    const NUM_OF_INSTRUCTIONS = $width(INSTRUCTIONS,0) // compute how many instructions are there
    
    always {
        if (addr < NUM_OF_INSTRUCTIONS){ // check if addr < number of instructions before slicing the array
            out = INSTRUCTIONS[addr]
        }
        else{
            out = 0
        }
        numinstr = NUM_OF_INSTRUCTIONS
    }
}
