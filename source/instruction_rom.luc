module instruction_rom #(
    WORDS = 16 // total instructions in this ROM
)(
    input addr[$clog2(WORDS)], // this ROM is WORD addressable
    output out[32],
output numinstr[10]
) {
    
    // Driver code, the bottommost instruction is the first instruction
    const INSTRUCTIONS = {
        // should execute 23 instructions
        32h7BE1FFFB, // 0x018 BNE(R3, 0x00C, R31) -- expect pcsel_out to be 0x
        32hE03B000F, // 0x014 ANDC(bp, 0xF, r1)
        32hC77B0004, // 0x010 SUBC(bp, 4, bp) -- expect wdsel_out to be from 0x3C to 0x30
        32h605F0010, // 0x00C LD(R31, 0x10, R2) -- expect mrd = interrupt value
        32h641B0000, // 0x008 loop: ST(R0, 0, bp) -- expect asel_out = 0x6AE7
        32hC01F6AE7, // 0x004 ADDC(R31, 0x6AE7, R0) -- display value
        32hC37F0040  // 0x000 ADDC(R31, 0x40, BP) -- expect asel_out = 0, bsel_out = 0x40
    }
    
    const NUM_OF_INSTRUCTIONS = $width(INSTRUCTIONS,0) // compute how many instructions are there
    
    always {
        if (addr < NUM_OF_INSTRUCTIONS){ // check if addr < number of instructions before slicing the array
            out = INSTRUCTIONS[addr]
        }
        else{
            out = 0
        }
        numinstr = NUM_OF_INSTRUCTIONS
    }
}