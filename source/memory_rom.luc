module memory_rom #(
    WORDS = 16 // total instructions in this ROM
)(
    input addr[$clog2(WORDS)], // this ROM is WORD addressable
    output out[32],
output numinstr[10]
) {
    
    // Driver code, the bottommost instruction is the first instruction
    const MEMORY = {
h30000000,
h30000000,
h30000000,
h30000000,
hf0000000,
hd0000000,
hf0000000,
hd0000000,
h03000000,
h03000000,
h03000000,
h03000000,
h0f000000,
h0d000000,
h0f000000,
h0d000000,
h00000000,
h00000000,
h7f000000,
h5e000000,
hfe000000,
h5f000000,
h00000000,
h00000000,
h00000000,
h00000000,
h7f000000,
h5f000000,
h7f000000,
h58000000,
h00000000,
h00000000,
hd1121301,
hd1121301,
h31111100,
h31111100,
h06666666,
h06666666,
hf3030300,
hf3030300,
h11111111,
h11111111,
h44444444,
h44444444,
h44444444,
h44444444,
h11111111,
h11111111,
h770e0e07,
h770e0e07,
h70700070,
h70700070,
h00700070,
h00700070,
h07077077,
h07077077,
h10000007,
h10000007,
h4e0000e0,
h4e0000e0,
h01c00e00,
h01c00e00,
h00038000,
h00038000,
h00000000,
h00f0f0f0,
h00000000,
h00f0f0f0,
h00000000,
h00f0f000,
h00000000,
h00f0f0ff,
h00000000,
h25de739e,
h7454a154,
h5454a554,
h5c54a554,
h5dca844a,
h00000000,
h00000000,
h00000000,
h7d0a0000,
h55fbe000,
h55fbe000,
h290a0000,
h00000000,
h00000000,
h00000000,
h00000000,
h00000008,
h00000002,
h00000000,
h00000000,
h00000000,
h00000000,
h00000000
    }
    
    const NUM_OF_MEMORIES = $width(MEMORY,0) // compute how many instructions are there
    
    always {
        if (addr < NUM_OF_MEMORIES){ // check if addr < number of instructions before slicing the array
            out = MEMORY[addr]
        }
        else{
            out = 0
        }
        numinstr = NUM_OF_MEMORIES
    }
}
