module alu (
    input alufn[6],
    input a[32],
    input b[32],
    output out[32],
    output z,
    output v,
    output n
) {
    .a(a), .b(b) {
        adder adder(#SIZE(32), .alufn0(alufn))
        .alufn(alufn) {
            boolean bool
            shifter shift
            rotater rot
        }
    }
    sig addmul[32]
    compare cmp(.alufn(alufn))
    abs abs(.in(addmul))
    reverse rev(.in(addmul))
    always {
        addmul = adder.s
        z = adder.z
        v = adder.v
        n = adder.n
        cmp.z = adder.z
        cmp.v = adder.v
        cmp.n = adder.n
        out = 0
        case (alufn[5:4]) {
            b00:
                out = addmul
            b01:
                out = bool.bool
            b10:
                case (alufn[3:2]) {
                    b00:
                        out = shift.shift // SHL, SHR, SRA
                    b01:
                        out = rot.shift // ROL, ROR
                    b10:
                        out = rev.out // reverse add, sub, mul
                    b11:
                        out = abs.out // absolute add, sub, mul
                }
            b11:
                out = c{31b0, cmp.cmp}
        }
    }
}