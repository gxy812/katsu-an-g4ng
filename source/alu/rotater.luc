module rotater #(SIZE = 32 : SIZE > 2) (
    input a[SIZE],
    input b[$clog2(SIZE)],
    input alufn[6],
    output shift[SIZE]
) {
    always {
        if (alufn[0]) { // right rotate
            shift = a >> b | a << (SIZE - b)
        }
        else {
            shift = a << b | a << (SIZE - b)
        }
    }
}